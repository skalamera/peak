<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="4dp">

    <!-- Zero-scroll minimalist Eurocharged landscape dashboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Pane: 3-Band Vertical (Pills -> 2 Eurocharged Dials -> Eurocharged Logo) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.28"
            android:orientation="vertical">

            <!-- Band 1: Prominent WMI Status Module + Symmetric Est. Power Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.cl600.obd.ui.WmiIndicatorView
                    android:id="@+id/wmiIndicator"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/layoutPowerPill"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp">

                    <TextView
                        android:id="@+id/tvPowerPillLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTIMATED OUTPUT"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPowerPillHp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- HP"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:typeface="monospace" />

                        <TextView
                            android:id="@+id/tvPowerPillSep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="•"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvPowerPillTq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- LB-FT"
                            android:textColor="@color/accent_silver"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:typeface="monospace" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Band 2: Dual Eurocharged Analog Dials -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.cl600.obd.ui.AnalogGaugeView
                    android:id="@+id/gaugeBoost"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1" />

                <com.cl600.obd.ui.AnalogGaugeView
                    android:id="@+id/gaugeIat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Band 3: Eurocharged Brand Emblem -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivEurochargedLogo"
                    android:layout_width="280dp"
                    android:layout_height="74dp"
                    android:alpha="1.0"
                    android:contentDescription="Eurocharged"
                    android:scaleType="fitCenter"
                    android:src="@drawable/eurocharged_logo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Pane: 2x2 Minimalist Digital Cards -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.cl600.obd.ui.DigitalGaugeCard
                    android:id="@+id/cardCoolant"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <com.cl600.obd.ui.DigitalGaugeCard
                    android:id="@+id/cardVoltage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.cl600.obd.ui.DigitalGaugeCard
                    android:id="@+id/cardRpm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <com.cl600.obd.ui.DigitalGaugeCard
                    android:id="@+id/cardExtra"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvGaugeFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Tap CONNECT to pair your OBDII adapter or try DEMO mode"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:typeface="monospace" />

</LinearLayout>
