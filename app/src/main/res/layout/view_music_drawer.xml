<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="364dp"
    android:layout_height="match_parent"
    android:background="#050506"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <!-- Crisp 1dp left border separating drawer from gauges -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/border_active" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header row: YT Music brand, WEB/APP switcher, Reload, Collapse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/bg_topbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="YouTube Music"
                app:srcCompat="@drawable/ic_ytm_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="YOUTUBE MUSIC"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Mode switcher: WEB vs APP -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_input_box"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnModeWeb"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_tab_pill"
                    android:gravity="center"
                    android:text="WEB"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnModeApp"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="APP"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnYtmReload"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDrawerCollapse"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Collapse drawer"
                android:padding="4dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_chevron_right" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle" />

        <!-- Persistent compact Now Playing + Quick Transport strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="6dp"
                android:paddingRight="6dp">

                <TextView
                    android:id="@+id/tvDrawerTrack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="No active track"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDrawerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Sign in below or switch to APP"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDrawerLike"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Like track"
                android:padding="6dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_thumb_up" />

            <ImageButton
                android:id="@+id/btnDrawerPrev"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous track"
                android:padding="5dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_media_prev" />

            <ImageButton
                android:id="@+id/btnDrawerPlayPause"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_rail_play_pill"
                android:contentDescription="Play or pause"
                android:padding="6dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/btnDrawerNext"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next track"
                android:padding="5dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_media_next" />

            <ImageButton
                android:id="@+id/btnDrawerDislike"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dislike track"
                android:padding="6dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_thumb_down" />
        </LinearLayout>

        <!-- Thin horizontal progress hairline -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/border_subtle">

            <View
                android:id="@+id/viewDrawerProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E11D48"
                android:scaleX="0" />
        </FrameLayout>

        <!-- Body: WEB Mode (WebView + OAuth block banner) OR APP Mode (Companion pane) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_root">

            <FrameLayout
                android:id="@+id/layoutWebPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webViewYtm"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/bg_root" />

                <ProgressBar
                    android:id="@+id/progressBarYtmWeb"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="top"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Shown only if Google OAuth blocks embedded WebView sign-in -->
                <LinearLayout
                    android:id="@+id/layoutWebAuthBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GOOGLE SIGN-IN BLOCKED IN EMBEDDED BROWSER"
                        android:textColor="@color/status_error"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="You can still browse here, or switch to APP companion mode to sign in inside the native YouTube Music app while keeping the cockpit quick rail active."
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnBannerRetryHome"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="6dp"
                            android:layout_marginRight="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_secondary"
                            android:gravity="center"
                            android:text="YTM HOME"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnBannerSwitchApp"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1.5"
                            android:background="@drawable/bg_btn_primary"
                            android:gravity="center"
                            android:text="SWITCH TO APP MODE"
                            android:textColor="@color/bg_root"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <ScrollView
                android:id="@+id/layoutAppPane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#060608"
                android:fillViewport="true"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppSessionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="APP COMPANION MODE"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Active track showcase -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvAppBigTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Ready for Native YT Music"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAppBigArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Launch YouTube Music app or press Play"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnOpenYtmApp"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_btn_primary"
                            android:gravity="center"
                            android:text="OPEN YOUTUBE MUSIC APP"
                            android:textColor="@color/bg_root"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Companion quick transport pad -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card_dark"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="6dp">

                        <ImageButton
                            android:id="@+id/btnAppVolDown"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Volume down"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_vol_down" />

                        <ImageButton
                            android:id="@+id/btnAppLike"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Like"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_thumb_up" />

                        <ImageButton
                            android:id="@+id/btnAppPrev"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Previous"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_media_prev" />

                        <ImageButton
                            android:id="@+id/btnAppPlayPause"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/bg_rail_play_pill"
                            android:contentDescription="Play or Pause"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_media_play" />

                        <ImageButton
                            android:id="@+id/btnAppNext"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Next"
                            android:padding="6dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_media_next" />

                        <ImageButton
                            android:id="@+id/btnAppDislike"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Dislike"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_thumb_down" />

                        <ImageButton
                            android:id="@+id/btnAppVolUp"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Volume up"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_vol_up" />
                    </LinearLayout>

                    <!-- Notification Listener status / grant card -->
                    <LinearLayout
                        android:id="@+id/layoutNotifAccessCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvNotifAccessDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Media keys &amp; volume work now. Grant Notification Listener access to sync track titles, progress, and Like/Dislike thumbs from the YT Music app."
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/btnGrantNotifAccess"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_secondary"
                            android:gravity="center"
                            android:text="ENABLE TRACK &amp; RATING SYNC"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
