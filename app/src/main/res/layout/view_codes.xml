<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- MIL Status & Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutMilBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMilStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECK ENGINE (MIL): UNKNOWN"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDtcSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Connect to your CL600 or launch Demo mode to scan fault codes."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnScanCodes"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
            android:minWidth="120dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/scan_codes"
            android:textColor="#0A0C10"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearCodes"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_danger"
            android:minWidth="120dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/clear_codes"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Codes List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDtcs"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvEmptyDtcs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_dark"
            android:gravity="center"
            android:padding="24dp"
            android:text="No fault codes loaded yet.\nTap SCAN CODES while ignition is ON."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvScopeNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Note: Standard ELM327 OBD-II reads &amp; clears Engine / Emissions fault codes (P-codes, Mode 03/07/04). Mercedes chassis modules (ABC, ESP, SRS) require MB STAR/DAS."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>
