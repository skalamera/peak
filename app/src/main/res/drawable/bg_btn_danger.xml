<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#150608" />
            <stroke android:width="1dp" android:color="#3F151A" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7F1D1D" />
            <stroke android:width="1dp" android:color="#FCA5A5" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E080A" />
            <stroke android:width="1dp" android:color="#EF4444" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
