<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#141416" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1D" />
            <stroke android:width="1dp" android:color="#3A3A40" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080809" />
            <stroke android:width="1dp" android:color="#1D1D20" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
